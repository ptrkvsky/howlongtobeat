{
  "name": "game-over.io",
  "description": "Le temps de jeu de vos jeux favoris",
  "version": "2.0.0",
  "private": true,
  "author": "Johan Petrikovky",
  "license": "MIT",
  "keywords": [
    "astro",
    "static"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --port 2811",
    "build": "astro build",
    "start": "astro preview --port 2881",
    "type-check": "astro check",
    "lint": "eslint src scripts",
    "format": "prettier \"src/**/*.+(ts|js|astro|css)\" --write",
    "prepare": "husky",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "lint-staged": {
    "./src/**/*.{ts,js,astro}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@sanity/client": "8.9.0",
    "astro": "7.3.5",
    "drizzle-orm": "0.45.3",
    "marked": "18.1.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "@vercel/blob": "2.8.2",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-prettier": "5.5.7",
    "fast-xml-parser": "5.11.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "openai": "7.36.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}
