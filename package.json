{
  "name": "game-over.io",
  "description": "Le temps de jeu de vos jeux favoris",
  "version": "2.0.0",
  "private": true,
  "author": "Johan Petrikovky",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "starter",
    "typescript"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 2811",
    "build": "tsx scripts/build-static-data.ts && next build",
    "start": "serve out -l 2881",
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier \"src/**/*.+(ts|js|tsx)\" --write",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "./src/**/*.{ts,js,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@portabletext/react": "8.0.1",
    "@reduxjs/toolkit": "2.13.0",
    "@sanity/client": "8.9.0",
    "emotion-reset": "3.0.1",
    "fuse.js": "7.5.0",
    "get-youtube-id": "1.0.1",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-circular-progressbar": "2.2.0",
    "react-dom": "19.3.1",
    "react-gtm-module": "2.0.11",
    "react-redux": "9.3.0",
    "react-youtube": "10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-gtm-module": "2.0.4",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
