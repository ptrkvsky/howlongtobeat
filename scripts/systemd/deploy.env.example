# Copy to ~/.config/game-over/deploy.env and chmod 600 it.

# https://vercel.com/account/settings/tokens
VERCEL_TOKEN=
# "orgId" and "id" of the project in .vercel/repo.json (or project.json)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional: data update run before the build. Each sync only refreshes the
# games whose data is older than --max-age days (see scripts/sync.ts)
# UPDATE_CMD=pnpm tsx scripts/sync.ts ids --max-age 90 && pnpm tsx scripts/sync.ts igdb --max-age 30 && pnpm tsx scripts/sync.ts steam --max-age 7

# Optional: https://healthchecks.io ping URL, alerts when a run fails or is missed
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# Optional: the same for the hourly news runs (scripts/news.sh), on a separate
# check with a one-hour period
# NEWS_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# Optional: refuse to deploy below this share of the previous page count
# MIN_PAGE_RATIO=0.95
