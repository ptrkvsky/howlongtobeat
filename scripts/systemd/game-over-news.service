# Hourly news run of game-over.io (user unit, see README.md here)
[Unit]
Description=Write the game-over.io news and deploy them
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/howlongtobeat
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, NEWS_HEALTHCHECK_URL
EnvironmentFile=%h/.config/game-over/deploy.env
# Login shell so node, pnpm and vercel are on the PATH (nvm, corepack...).
# publish-news.ts reads .env.local: OPENAI_API_KEY, DATABASE_URL,
# IGDB_CLIENT_ID, IGDB_CLIENT_SECRET
ExecStart=/bin/bash -lc 'scripts/news.sh'
TimeoutStartSec=30min
Nice=10
