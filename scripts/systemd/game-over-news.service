# Hourly news article of game-over.io (user unit, see README.md here)
[Unit]
Description=Write and publish one game-over.io news article
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/howlongtobeat
# Login shell so node and pnpm are on the PATH (nvm, corepack...). The
# script reads .env.local: OPENAI_API_KEY, BLOB_READ_WRITE_TOKEN,
# DATABASE_URL, IGDB_CLIENT_ID, IGDB_CLIENT_SECRET
ExecStart=/bin/bash -lc 'pnpm tsx scripts/publish-news.ts'
TimeoutStartSec=15min
Nice=10
