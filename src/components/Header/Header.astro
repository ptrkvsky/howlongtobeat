---
import urls from '@/config/urls';
import Flag from '@/features/home/components/Flag.astro';
import home from '@/features/home/components/home.module.css';
import styles from './header.module.css';

interface Props {
  // A thin reading-progress bar pinned to the very top of the viewport, for
  // long pages (articles, game sheets). Outside the header, not a child of
  // it, so it stays visible even once the header has hidden itself on
  // scroll down. Driven by header.ts
  progress?: boolean;
}

const { progress = false } = Astro.props;

// Header of every page, smart sticky (header.ts: compact then hidden on
// scroll, back on scroll up). The search is the field of the hero on the
// home (scripts/search.ts gives it the focus); elsewhere the same button
// opens a dialog with the same combobox (features/search/headerSearch.ts)
const { pathname } = Astro.url;
const isHome = pathname === urls.home;

// `match` decides which link is current: the genre pages belong to "Genres"
const links = [
  {
    url: urls.genres,
    label: `Genres`,
    match: (path: string) => path === urls.genres || path.startsWith(`/genre/`),
  },
  {
    url: urls.actus,
    label: `Actus`,
    match: (path: string) => path.startsWith(urls.actus),
  },
];
---

{progress && (
  <div class={styles.progress} aria-hidden="true" data-progress-bar></div>
)}
<header class:list={[home.page, home.paper, styles.header]} data-header>
  <div class:list={[home.frame, styles.inner]}>
    <a href={urls.home} class={styles.logo} aria-label="Game Over, accueil">
      <Flag class={styles.flag} />
      <span>Game Over</span>
    </a>
    <nav aria-label="Navigation principale">
      <ul class={styles.links}>
        {links.map(({ url, label, match }) => (
          <li>
            <a
              href={url}
              class={styles.link}
              aria-current={match(pathname) ? `page` : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      type="button"
      class={styles.search}
      aria-label="Rechercher un jeu"
      aria-keyshortcuts="/"
      data-search-open
    >
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <circle
          cx="6.5"
          cy="6.5"
          r="5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></circle>
        <path
          d="M10.5 10.5 15 15"
          stroke="currentColor"
          stroke-width="1.5"
        ></path>
      </svg>
      <span class={styles.searchLabel}>Rechercher un jeu</span>
      <kbd class={styles.key} aria-hidden="true">
        /
      </kbd>
    </button>
  </div>
  {!isHome && (
    <dialog
      class={styles.dialog}
      data-search-dialog
      aria-label="Rechercher un jeu"
    >
      <div class={styles.dialogBox}>
        <div class={styles.dialogField}>
          <label for="header-game" class={home.srOnly}>
            Rechercher un jeu
          </label>
          <input
            id="header-game"
            class={styles.dialogInput}
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="header-results"
            aria-describedby="header-search-hint"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Nom d'un jeu…"
            data-search-input
          />
          <button
            type="button"
            class={styles.dialogClose}
            data-search-close
            aria-label="Fermer la recherche"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                d="M3 3 13 13 M13 3 3 13"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
            </svg>
          </button>
        </div>
        <ul
          id="header-results"
          class={styles.dialogResults}
          role="listbox"
          aria-label="Jeux trouvés"
          hidden
          data-search-results
        ></ul>
        <p id="header-search-hint" class={home.srOnly}>
          Tapez le nom d'un jeu, puis choisissez-le dans la liste avec les
          flèches et Entrée.
        </p>
      </div>
    </dialog>
  )}
</header>

<script>
  import './header';
</script>
<script>
  import '@/features/search/headerSearch';
</script>
