---
import { PAGINATION_BLOCK } from '@/config/pagination';
import styles from './pagination.module.css';

// Page 1 is baseUrl, the next ones baseUrl/2, baseUrl/3… (Astro paginate)
interface Props {
  baseUrl: string;
  currentPage: number;
  lastPage: number;
}

const { baseUrl, currentPage, lastPage } = Astro.props;
const pageUrl = (page: number) => (page === 1 ? baseUrl : `${baseUrl}/${page}`);

// Level 1: every page of the current block of ten
const blockStart =
  Math.floor((currentPage - 1) / PAGINATION_BLOCK) * PAGINATION_BLOCK + 1;
const blockEnd = Math.min(blockStart + PAGINATION_BLOCK - 1, lastPage);
const pages: number[] = [];
for (let page = blockStart; page <= blockEnd; page++) pages.push(page);

// Level 2: one jump per ten (10, 20, 30…) and the last page, outside the block
const jumps: number[] = [];
for (let page = PAGINATION_BLOCK; page < lastPage; page += PAGINATION_BLOCK) {
  jumps.push(page);
}
jumps.push(lastPage);
const otherJumps = jumps.filter((page) => page < blockStart || page > blockEnd);
---

{lastPage > 1 && (
  <nav aria-label="Pagination" class={styles.pagination}>
    <ol>
      {currentPage > 1 && (
        <li>
          <a href={pageUrl(currentPage - 1)} rel="prev">
            Précédent
          </a>
        </li>
      )}
      {pages.map((page) =>
        page === currentPage ? (
          <li>
            <span aria-current="page">{page}</span>
          </li>
        ) : (
          <li>
            <a href={pageUrl(page)}>{page}</a>
          </li>
        ),
      )}
      {currentPage < lastPage && (
        <li>
          <a href={pageUrl(currentPage + 1)} rel="next">
            Suivant
          </a>
        </li>
      )}
    </ol>
    {otherJumps.length > 0 && (
      <ol aria-label="Pages par dizaines" class={styles.jumps}>
        {otherJumps.map((page) => (
          <li>
            <a href={pageUrl(page)}>{page}</a>
          </li>
        ))}
      </ol>
    )}
  </nav>
)}
