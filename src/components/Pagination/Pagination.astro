---
import styles from './pagination.module.css';

// Page 1 is baseUrl, the next ones baseUrl/2, baseUrl/3… (Astro paginate)
interface Props {
  baseUrl: string;
  currentPage: number;
  lastPage: number;
}

const { baseUrl, currentPage, lastPage } = Astro.props;
const pageUrl = (page: number) => (page === 1 ? baseUrl : `${baseUrl}/${page}`);

// First, last and two pages around the current one, null for a gap
const pages: (number | null)[] = [];
for (let page = 1; page <= lastPage; page++) {
  if (page === 1 || page === lastPage || Math.abs(page - currentPage) <= 2) {
    pages.push(page);
  } else if (pages.at(-1) !== null) {
    pages.push(null);
  }
}
---

{lastPage > 1 && (
  <nav aria-label="Pagination" class={styles.pagination}>
    <ol>
      {currentPage > 1 && (
        <li>
          <a href={pageUrl(currentPage - 1)} rel="prev">
            Précédent
          </a>
        </li>
      )}
      {pages.map((page) =>
        page === null ? (
          <li aria-hidden="true">…</li>
        ) : page === currentPage ? (
          <li>
            <span aria-current="page">{page}</span>
          </li>
        ) : (
          <li>
            <a href={pageUrl(page)}>{page}</a>
          </li>
        ),
      )}
      {currentPage < lastPage && (
        <li>
          <a href={pageUrl(currentPage + 1)} rel="next">
            Suivant
          </a>
        </li>
      )}
    </ol>
  </nav>
)}
