---
import type { MarkProps } from 'astro-portabletext/types';
import CloakLink from '@/components/CloakLink.astro';

type Props = MarkProps<{
  _type: `link`;
  href: string;
  blank?: boolean;
  cloaked?: boolean;
  sponsored?: boolean;
  noreferrer?: boolean;
  ugc?: boolean;
}>;

const { href, blank, cloaked, sponsored, noreferrer, ugc } =
  Astro.props.node.markDef;

const rel = [
  blank && `noopener noreferrer`,
  sponsored && `sponsored`,
  noreferrer && `noreferrer`,
  ugc && `ugc`,
]
  .filter(Boolean)
  .join(` `);
---

{cloaked ? (
  <CloakLink url={href}>
    <slot />
  </CloakLink>
) : (
  <a href={href} rel={rel || undefined} target={blank ? `_blank` : undefined}>
    <slot />
  </a>
)}
