---
import { PortableText as BasePortableText } from 'astro-portabletext';
import type { PortableTextBlock } from '@portabletext/types';
import Heading from './Heading.astro';
import InternalLink from './InternalLink.astro';
import Link from './Link.astro';
import Youtube from './Youtube.astro';

interface Props {
  blocks: PortableTextBlock[];
}

const { blocks } = Astro.props;

const components = {
  block: { h2: Heading, h3: Heading, h4: Heading, h5: Heading, h6: Heading },
  type: { youtube: Youtube },
  mark: { internalLink: InternalLink, link: Link },
};
---

<BasePortableText value={blocks} components={components} />
