---
// Checkered finish flag, the mark of the home (logo, finish lines)
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const squares = [0, 1, 2].flatMap((row) =>
  [0, 1, 2, 3]
    .filter((column) => (row + column) % 2 === 0)
    .map((column) => ({ x: column * 3, y: row * 3 })),
);
---

<svg
  class={className}
  viewBox="0 0 12 9"
  width="12"
  height="9"
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="0.5"
    y="0.5"
    width="11"
    height="8"
    fill="none"
    stroke="currentColor"
  />
  {squares.map(({ x, y }) => (
    <rect {x} {y} width="3" height="3" fill="currentColor" />
  ))}
</svg>
