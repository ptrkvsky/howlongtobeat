---
import type { GameSummary } from '@/types/Game';
import { igdbImage } from '@/utils/igdbImage';

interface Props {
  game: GameSummary;
  priority?: boolean;
}

const { game, priority = false } = Astro.props;
---

<div
  style={`position: relative; ${priority ? `width: var(--cover-width, 352px); max-width: 100%; aspect-ratio: 352 / 469` : `width: 352px; height: 469px`}`}
>
  <img
    alt={game.name}
    src={igdbImage(game.cover!, `cover_big_2x`)}
    width="352"
    height="469"
    loading={priority ? `eager` : `lazy`}
    fetchpriority={priority ? `high` : undefined}
    decoding="async"
    style="width: 100%; height: auto"
  />
</div>
