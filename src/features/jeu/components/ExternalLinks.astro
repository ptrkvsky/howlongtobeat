---
import type { GameLinks } from '@/types/Game';
import { externalLinks } from '@/utils/externalLinks';
import styles from './enriched.module.css';

// F6: only confirmed ids get a link
interface Props {
  links: GameLinks;
}

const { links } = Astro.props;
const items = externalLinks(links);
---

{items.length > 0 && (
  <ul class={styles.links}>
    {items.map((item) => (
      <li>
        <a href={item.href} target="_blank" rel="noopener">
          {item.label}
        </a>
      </li>
    ))}
  </ul>
)}
