---
import type { Game } from '@/types/Game';
import {
  getGameTimes,
  isCurrentHltbTime,
} from '@/features/jeu/utils/gameTimes';
import { formatCount, formatDate } from '@/utils/format';
import styles from './time.module.css';

// HLTB times in hours, with the number of players behind each one (the
// sentence answer is in Verdict.astro)
interface Props {
  game: Game;
}

const { game } = Astro.props;
const times = getGameTimes(game);
const max = Math.max(...times.map((time) => time.hours));
const hours = (value: number) => `${value} h`;
const players = (count: number) =>
  `${formatCount(count)} joueur${count > 1 ? `s` : ``}`;
// Few submissions: one speedrun or forgotten timer moves the average a lot
const reliability = (count: number) =>
  count < 10
    ? { label: `estimation fragile`, weak: true }
    : count < 100
      ? { label: `fiable`, weak: false }
      : { label: `très fiable`, weak: false };
// The median is shown when the average is pulled away from it
const median = game.hltb?.mainMedian ?? 0;
const showMedian =
  median > 0 &&
  isCurrentHltbTime(game, `main`) &&
  Math.abs(median - game.timeMainStory) / game.timeMainStory > 0.1;
---

{times.length > 0 && (
  <section class={styles.times} aria-labelledby="durees">
    <h2 id="durees" class={styles.heading}>
      Durée de vie
    </h2>
    <ul class={styles.cards}>
      {times.map((time) => (
        <li class={styles.card}>
          <span class={styles.label}>{time.label}</span>
          <span class={styles.hours}>{hours(time.hours)}</span>
          <span
            class={styles.bar}
            style={`--ratio: ${time.hours / max}`}
            aria-hidden="true"
          ></span>
          {time.key === `main` && showMedian && (
            <span class={styles.detail}>médiane : {hours(median)}</span>
          )}
          {time.count != null && time.count > 0 && (
            <span class={styles.detail}>
              d'après {players(time.count)}
              <span
                class:list={[
                  styles.reliability,
                  reliability(time.count).weak && styles.weak,
                ]}
              >
                {reliability(time.count).label}
              </span>
            </span>
          )}
        </li>
      ))}
    </ul>
    <p class={styles.source}>
      Source : HowLongToBeat
      {times.some((time) => time.count != null) && (
        <>, relevé le {formatDate(game.hltb!.updatedAt)}</>
      )}
    </p>
  </section>
)}
