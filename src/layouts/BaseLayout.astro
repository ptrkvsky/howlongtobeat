---
import { siteInformations } from '@/config/siteInformations';
import { graph, type JsonLdNode } from '@/utils/structuredData';
import '@/styles/globals.css';

interface Props {
  title?: string;
  // Full title, without the " - Game Over" suffix
  absoluteTitle?: string;
  description?: string;
  canonical?: string;
  // Previous and next pages of a paginated list
  prev?: string;
  next?: string;
  ogImage?: string;
  noindex?: boolean;
  // Large previews in Google Discover, for the pages with a large image
  largeImagePreview?: boolean;
  // schema.org nodes, rendered as one JSON-LD @graph
  jsonLd?: JsonLdNode[];
  // Open Graph type: an /actus article, an author page or any other page
  ogType?: `website` | `article` | `profile`;
  // Fonts of the first screen, loaded with the HTML (the home's hero)
  preloadFonts?: string[];
  // article:* Open Graph tags of an /actus article
  article?: {
    publishedTime: string;
    modifiedTime: string;
    // Author page URL and name
    authorUrl: string;
    authorName: string;
    section: string;
  };
}

const {
  title,
  absoluteTitle,
  description,
  canonical,
  prev,
  next,
  ogImage,
  noindex,
  largeImagePreview,
  jsonLd,
  ogType = `website`,
  article,
  preloadFonts = [],
} = Astro.props;

const fullTitle =
  absoluteTitle ??
  (title ? `${title} - ${siteInformations.title}` : siteInformations.title);
const gtmId = siteInformations.tagManager;
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {preloadFonts.map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    ))}
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && largeImagePreview && (
      <meta name="robots" content="max-image-preview:large" />
    )}
    {canonical && (
      <link rel="canonical" href={new URL(canonical, Astro.site)} />
    )}
    {prev && <link rel="prev" href={new URL(prev, Astro.site)} />}
    {next && <link rel="next" href={new URL(next, Astro.site)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteInformations.title} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={absoluteTitle ?? title ?? fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {canonical && (
      <meta property="og:url" content={new URL(canonical, Astro.site)} />
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {article && (
      <>
        <meta name="author" content={article.authorName} />
        <meta
          property="article:published_time"
          content={article.publishedTime}
        />
        <meta property="article:modified_time" content={article.modifiedTime} />
        <meta
          property="article:author"
          content={new URL(article.authorUrl, Astro.site)}
        />
        <meta property="article:section" content={article.section} />
      </>
    )}
    {jsonLd?.length && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(graph(jsonLd)).replace(/</g, `\\u003c`)}
      />
    )}
    <meta
      name="twitter:card"
      content={largeImagePreview ? `summary_large_image` : `summary`}
    />
    <meta name="twitter:site" content={siteInformations.twitter} />
    <meta name="theme-color" content="#6100FF" />
    <meta
      name="google-site-verification"
      content="JToiALKPVzracQqpHh9U1OEf0n1wkC9Z8VaRsUmSboo"
    />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/icons/76x76.png" type="image/png" sizes="76x76" />
    <link rel="icon" href="/icons/72x72.png" type="image/png" sizes="72x72" />
    <link rel="apple-touch-icon" href="/icons/180x180.png" />
    <script is:inline set:html={gtmSnippet} />
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display: none; visibility: hidden"
      ></iframe>
    </noscript>
    <slot />
    <script>
      import '@/scripts/enhance';
    </script>
  </body>
</html>
