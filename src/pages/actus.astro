---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Breadcrumb from '@/components/Breadcrumb/Breadcrumb.astro';
import HomeTitle from '@/styles/components/titles/HomeTitle.astro';
import { newsCategoryLabels, newsPageUrl } from '@/config/news';
import { getNewsIndex } from '@/features/actus/api';
import { formatDate, formatDayAndTime } from '@/features/actus/format';
import {
  breadcrumbNode,
  organizationNode,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';
import styles from '@/styles/actus.module.css';

// The 5 latest news, published every hour on Vercel Blob by
// scripts/publish-news.ts: rendered on demand, cached by the CDN
export const prerender = false;

const index = await getNewsIndex().catch((error) => {
  console.error(error);
  return null;
});
Astro.response.headers.set(
  `Cache-Control`,
  index
    ? `public, s-maxage=300, stale-while-revalidate=3600`
    : `public, s-maxage=60`,
);

const path = `/actus`;
const title = `Actus jeux vidéo`;
const description = `Les dernières actus jeux vidéo : sorties, mises à jour et annonces, avec le temps qu'il faut pour finir les jeux concernés.`;
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Actus`, path },
];
---

<BaseLayout
  {title}
  {description}
  canonical={path}
  jsonLd={[
    websiteNode(),
    organizationNode(),
    webPageNode({ type: `CollectionPage`, path, name: title, description }),
    breadcrumbNode(path, breadcrumb),
  ]}
>
  <LayoutFront isCentered>
    <Breadcrumb items={breadcrumb} />
    <HomeTitle>Actus</HomeTitle>
    {index ? (
      <>
        <p class={styles.meta}>
          Mis à jour le {formatDayAndTime(new Date(index.updatedAt))}.
        </p>
        <ol class={styles.list}>
          {index.articles.map((article, position) => (
            <li class={styles.card}>
              <a class={styles.link} href={newsPageUrl(article.slug)}>
                <img
                  class={styles.image}
                  src={article.image.url}
                  alt={article.image.alt}
                  loading={position === 0 ? `eager` : `lazy`}
                  width="320"
                  height="180"
                />
                <div class={styles.body}>
                  <p class={styles.date}>
                    {newsCategoryLabels[article.category]} ·{` `}
                    <time datetime={article.date}>
                      {formatDate.format(new Date(article.date))}
                    </time>
                  </p>
                  <h2 class={styles.title}>{article.title}</h2>
                  <p class={styles.excerpt}>{article.excerpt}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </>
    ) : (
      <p class={styles.meta}>
        Les actus ne sont pas disponibles pour le moment.
      </p>
    )}
  </LayoutFront>
</BaseLayout>
