---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Breadcrumb from '@/components/Breadcrumb/Breadcrumb.astro';
import Pagination from '@/components/Pagination/Pagination.astro';
import HomeTitle from '@/styles/components/titles/HomeTitle.astro';
import { newsPageUrl, type NewsSummary } from '@/config/news';
import { NEWS_PAGE_SIZE } from '@/config/pagination';
import urls from '@/config/urls';
import { getNewsArticles } from '@/features/actus/api';
import NewsCard from '@/features/actus/components/NewsCard.astro';
import { formatDayAndTime } from '@/features/actus/format';
import {
  breadcrumbNode,
  itemListNode,
  organizationNode,
  pageIds,
  ref,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';
import styles from '@/styles/actus.module.css';

// /actus for the latest news, then /actus/2… The articles are written every
// hour by scripts/publish-news.ts, which redeploys the site
export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getNewsArticles(), {
    pageSize: NEWS_PAGE_SIZE,
  })) satisfies GetStaticPaths;

interface Props {
  page: Page<NewsSummary>;
}

const { page } = Astro.props;
const canonical = page.url.current;
// Other pages get their own title and description
const pageSuffix = page.currentPage > 1 ? ` - Page ${page.currentPage}` : ``;
const title = `Actus jeux vidéo${pageSuffix}`;
const description = `Les dernières actus jeux vidéo : sorties, mises à jour et annonces, avec le temps qu'il faut pour finir les jeux concernés.${pageSuffix}`;
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Actus`, path: urls.actus },
  ...(page.currentPage > 1
    ? [{ name: `Page ${page.currentPage}`, path: canonical }]
    : []),
];
const latest = page.currentPage === 1 ? page.data[0] : undefined;
---

<BaseLayout
  {title}
  {description}
  {canonical}
  prev={page.url.prev}
  next={page.url.next}
  jsonLd={[
    websiteNode(),
    organizationNode(),
    webPageNode({
      type: `CollectionPage`,
      path: canonical,
      name: title,
      description,
      extra: { mainEntity: ref(pageIds(canonical).itemList) },
    }),
    breadcrumbNode(canonical, breadcrumb),
    itemListNode(
      canonical,
      page.data.map((article) => ({
        name: article.title,
        path: newsPageUrl(article.slug),
      })),
      { total: page.total, start: page.start },
    ),
  ]}
>
  <LayoutFront isCentered>
    <Breadcrumb items={breadcrumb} />
    <HomeTitle>Actus</HomeTitle>
    {page.total > 0 ? (
      <>
        {latest && (
          <p class={styles.meta}>
            Mis à jour le {formatDayAndTime(new Date(latest.date))}.
          </p>
        )}
        <ol class={styles.list}>
          {page.data.map((article, position) => (
            <NewsCard {article} eager={position === 0} />
          ))}
        </ol>
        <Pagination
          baseUrl={urls.actus}
          currentPage={page.currentPage}
          lastPage={page.lastPage}
        />
      </>
    ) : (
      <p class={styles.meta}>
        Les actus ne sont pas disponibles pour le moment.
      </p>
    )}
  </LayoutFront>
</BaseLayout>
