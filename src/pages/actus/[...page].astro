---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import {
  newsPageUrl,
  type NewsCategory,
  type NewsSummary,
} from '@/config/news';
import { NEWS_PAGE_SIZE } from '@/config/pagination';
import urls from '@/config/urls';
import { getNewsArticles } from '@/features/actus/api';
import NewsListing from '@/features/actus/components/NewsListing.astro';
import {
  categoriesWithCount,
  pickLead,
  topGames,
  type TopGame,
} from '@/features/actus/data';
import {
  breadcrumbNode,
  itemListNode,
  organizationNode,
  pageIds,
  ref,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';

// /actus for the latest news, then /actus/2… The lead is picked from the
// latest articles and shown on the first page only; the flow below it holds
// the others. The articles are written every hour by scripts/publish-news.ts,
// which redeploys the site
export const getStaticPaths = (async ({ paginate }) => {
  const all = await getNewsArticles();
  const lead = pickLead(all);
  const flow = all.filter((article) => !lead.includes(article));
  return paginate(flow, {
    pageSize: NEWS_PAGE_SIZE,
    props: {
      lead,
      games: topGames(all, new Date()),
      categories: categoriesWithCount(all),
      total: all.length,
      latest: all[0],
    },
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<NewsSummary>;
  lead: NewsSummary[];
  games: TopGame[];
  categories: { category: NewsCategory; count: number }[];
  total: number;
  latest?: NewsSummary;
}

const { page, lead, games, categories, total, latest } = Astro.props;
const canonical = page.url.current;
const first = page.currentPage === 1;
// Other pages get their own title and description
const pageSuffix = first ? `` : ` - Page ${page.currentPage}`;
const title = `Actus jeux vidéo${pageSuffix}`;
const description = `Les dernières actus jeux vidéo : sorties, mises à jour et annonces, avec le temps qu'il faut pour finir les jeux concernés.${pageSuffix}`;
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Actus`, path: urls.actus },
  ...(first ? [] : [{ name: `Page ${page.currentPage}`, path: canonical }]),
];
const listed = first ? [...lead, ...page.data] : page.data;
---

<BaseLayout
  {title}
  {description}
  {canonical}
  prev={page.url.prev}
  next={page.url.next}
  jsonLd={[
    websiteNode(),
    organizationNode(),
    webPageNode({
      type: `CollectionPage`,
      path: canonical,
      name: title,
      description,
      extra: { mainEntity: ref(pageIds(canonical).itemList) },
    }),
    breadcrumbNode(canonical, breadcrumb),
    itemListNode(
      canonical,
      listed.map((article) => ({
        name: article.title,
        path: newsPageUrl(article.slug),
      })),
      { total, start: first ? 0 : page.start + lead.length },
    ),
  ]}
>
  <LayoutFront>
    <NewsListing
      {page}
      {breadcrumb}
      {categories}
      {total}
      {lead}
      {games}
      {latest}
      kicker="L'actu jeu vidéo"
      heading="Actus"
      lede="Sorties, mises à jour et annonces, avec le temps qu'il faut pour finir les jeux dont on parle."
      baseUrl={urls.actus}
    />
  </LayoutFront>
</BaseLayout>
