---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Breadcrumb from '@/components/Breadcrumb/Breadcrumb.astro';
import type { GetStaticPaths } from 'astro';
import { authorPageUrl, authors } from '@/config/authors';
import {
  newsCategoryLabels,
  newsPageUrl,
  type NewsArticle,
} from '@/config/news';
import urls from '@/config/urls';
import { getNewsArticles } from '@/features/actus/api';
import AuthorBox from '@/features/actus/components/AuthorBox.astro';
import Byline from '@/features/actus/components/Byline.astro';
import {
  breadcrumbNode,
  newsArticleNode,
  organizationNode,
  personNode,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';
import { adjacentArticles, relatedArticles } from '@/features/actus/data';
import { newsCategoryUrl } from '@/features/actus/urls';
import GameCard from '@/features/actus/components/GameCard.astro';
import PrevNext from '@/features/actus/components/PrevNext.astro';
import Related from '@/features/actus/components/Related.astro';
import home from '@/features/home/components/home.module.css';
import styles from '@/features/actus/components/news.module.css';

// One page per news article written by scripts/publish-news.ts
export const getStaticPaths = (async () =>
  (await getNewsArticles()).map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))) satisfies GetStaticPaths;

interface Props {
  article: NewsArticle;
}

const { article } = Astro.props;
const path = newsPageUrl(article.slug);
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Actus`, path: urls.actus },
  { name: article.title, path },
];
const imageUrl = new URL(article.image.url, Astro.site).href;
const author = authors[article.author];
const all = await getNewsArticles();
const related = relatedArticles(article, all);
const { newer, older } = adjacentArticles(article, all);
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  canonical={path}
  ogImage={imageUrl}
  largeImagePreview
  ogType="article"
  article={{
    publishedTime: article.date,
    modifiedTime: article.updatedAt,
    authorUrl: authorPageUrl(author.slug),
    authorName: author.name,
    section: newsCategoryLabels[article.category],
  }}
  jsonLd={[
    websiteNode(),
    organizationNode(),
    webPageNode({
      path,
      name: article.title,
      description: article.excerpt,
    }),
    breadcrumbNode(path, breadcrumb),
    newsArticleNode(path, article),
    personNode(author),
  ]}
>
  <LayoutFront>
    <div class={home.page}>
      <article class:list={[home.frame, styles.article]}>
        <Breadcrumb items={breadcrumb} />
        <header class={styles.articleHead}>
          <p class={home.kicker}>{newsCategoryLabels[article.category]}</p>
          <h1 class={styles.articleTitle}>{article.title}</h1>
          <Byline {article} />
          <p class={styles.articleLead}>{article.excerpt}</p>
        </header>
        <img
          class={styles.cover}
          src={article.image.url}
          alt={article.image.alt}
          width={article.image.width}
          height={article.image.height}
          fetchpriority="high"
        />
        <div class={styles.reading}>
          {/* HTML rendered by scripts/publish-news.ts, without raw HTML */}
          <div class={styles.content} set:html={article.content} />
          {article.game && <GameCard game={article.game} />}
          <AuthorBox slug={article.author} />
        </div>
      </article>
      <aside class={styles.after} aria-label="Pour continuer">
        <div class={home.frame}>
          <Related articles={related} gameName={article.game?.name} />
          <PrevNext {newer} {older} />
          <p class={styles.backLinks}>
            <a class={home.more} href={urls.actus}>
              ← Toutes les actus
            </a>
            <a class={home.more} href={newsCategoryUrl(article.category)}>
              Plus de « {newsCategoryLabels[article.category]} »
            </a>
          </p>
        </div>
      </aside>
    </div>
  </LayoutFront>
</BaseLayout>
