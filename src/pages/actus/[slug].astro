---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Breadcrumb from '@/components/Breadcrumb/Breadcrumb.astro';
import type { GetStaticPaths } from 'astro';
import { authorPageUrl, authors } from '@/config/authors';
import {
  newsCategoryLabels,
  newsPageUrl,
  type NewsArticle,
} from '@/config/news';
import urls from '@/config/urls';
import { getNewsArticles } from '@/features/actus/api';
import AuthorBox from '@/features/actus/components/AuthorBox.astro';
import Byline from '@/features/actus/components/Byline.astro';
import {
  breadcrumbNode,
  newsArticleNode,
  organizationNode,
  personNode,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';
import styles from '@/styles/actus.module.css';

// One page per news article written by scripts/publish-news.ts
export const getStaticPaths = (async () =>
  (await getNewsArticles()).map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))) satisfies GetStaticPaths;

interface Props {
  article: NewsArticle;
}

const { article } = Astro.props;
const path = newsPageUrl(article.slug);
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Actus`, path: urls.actus },
  { name: article.title, path },
];
const imageUrl = new URL(article.image.url, Astro.site).href;
const author = authors[article.author];
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  canonical={path}
  ogImage={imageUrl}
  largeImagePreview
  ogType="article"
  article={{
    publishedTime: article.date,
    modifiedTime: article.updatedAt,
    authorUrl: authorPageUrl(author.slug),
    authorName: author.name,
    section: newsCategoryLabels[article.category],
  }}
  jsonLd={[
    websiteNode(),
    organizationNode(),
    webPageNode({
      path,
      name: article.title,
      description: article.excerpt,
    }),
    breadcrumbNode(path, breadcrumb),
    newsArticleNode(path, article),
    personNode(author),
  ]}
>
  <LayoutFront isCentered>
    <Breadcrumb items={breadcrumb} />
    <article class={styles.article}>
      <h1 class={styles.articleTitle}>{article.title}</h1>
      <Byline {article} />
      <p class={styles.lead}>{article.excerpt}</p>
      <img
        class={styles.cover}
        src={article.image.url}
        alt={article.image.alt}
        width={article.image.width}
        height={article.image.height}
        fetchpriority="high"
      />
      {/* HTML rendered by scripts/publish-news.ts, without raw HTML */}
      <div class={styles.content} set:html={article.content} />
      {article.game && (
        <a class={styles.game} href={`/jeu/${article.game.slug}`}>
          <span>Combien de temps pour finir {article.game.name} ?</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
      <AuthorBox slug={article.author} />
      <a class={styles.back} href={urls.actus}>
        ← Toutes les actus
      </a>
    </article>
  </LayoutFront>
</BaseLayout>
