---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Breadcrumb from '@/components/Breadcrumb/Breadcrumb.astro';
import styles from '@/styles/actus.module.css';

// POC: one page for every GameSpot news, the article is loaded client-side
// from Vercel Blob (see scripts/fetch-gamespot.ts)
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Actus`, path: `/actus` },
  { name: `Article`, path: `/actus/article` },
];
---

<BaseLayout title="Actus jeux vidéo" noindex>
  <LayoutFront isCentered>
    <Breadcrumb items={breadcrumb} />
    <p class={styles.meta} data-article-status>
      Chargement de l'article…
    </p>
    <article class={styles.article} data-article hidden>
      <h1 class={styles.articleTitle}></h1>
      <p class={styles.date}>
        Publié le <time></time> sur GameSpot
      </p>
      <p class={styles.lead} data-excerpt></p>
      <img class={styles.cover} alt="" data-cover />
      <div class={styles.content} data-content></div>
      <p class={styles.source}>
        Article traduit de l'anglais.{` `}
        <a data-source target="_blank" rel="noopener nofollow">
          Lire l'article original sur GameSpot
        </a>
      </p>
      <a class={styles.back} href="/actus">
        ← Toutes les actus
      </a>
    </article>
  </LayoutFront>
</BaseLayout>

<script>
  import '@/features/actus/renderArticle';
</script>
