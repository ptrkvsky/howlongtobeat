---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import HomeTitle from '@/styles/components/titles/HomeTitle.astro';
import { getAllGenres } from '@/functions/getAllGenres';
import { getGamesByGenre } from '@/functions/getGamesByGenre';

export const getStaticPaths = (async () => {
  const genres = await getAllGenres();

  return Promise.all(
    genres.map(async (genre) => ({
      params: { slug: genre.slug },
      props: { genre, games: await getGamesByGenre(genre.id) },
    })),
  );
}) satisfies GetStaticPaths;

const { genre, games } = Astro.props;
---

<BaseLayout
  title={`Durée de vie des jeux ${genre.name}`}
  description={`Découvrez le temps nécessaire pour terminer les jeux ${genre.name}.`}
  canonical={`/genre/${genre.slug}`}
>
  <LayoutFront cloakFooter isCentered>
    <HomeTitle>
      {genre.name}
      <br /> {games.length} jeux
    </HomeTitle>
    <ul>
      {games.map((game) => (
        <li>
          <a href={`/jeu/${game.slug}`}>{game.name}</a>
        </li>
      ))}
    </ul>
  </LayoutFront>
</BaseLayout>
