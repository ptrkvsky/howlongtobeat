---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Pagination from '@/components/Pagination/Pagination.astro';
import { GENRE_PAGE_SIZE } from '@/config/pagination';
import { getAllGenres } from '@/functions/getAllGenres';
import Extremes from '@/features/genre/components/Extremes.astro';
import GameList from '@/features/genre/components/GameList.astro';
import GenreHero from '@/features/genre/components/GenreHero.astro';
import SimilarGenres from '@/features/genre/components/SimilarGenres.astro';
import { getGenreGames, getGenrePageData } from '@/features/genre/data';
import home from '@/features/home/components/home.module.css';
import { genreLabels } from '@/features/home/genres';
import type { Game } from '@/types/Game';
import type { Genre } from '@/types/Genre';
import {
  breadcrumbNode,
  itemListNode,
  pageIds,
  ref,
  webPageNode,
} from '@/utils/structuredData';

// /genre/<slug> for the first page, then /genre/<slug>/2…
export const getStaticPaths = (async ({ paginate }) => {
  const genres = await getAllGenres();

  const pages = await Promise.all(
    genres.map(async (genre) =>
      paginate(await getGenreGames(genre.id), {
        params: { slug: genre.slug },
        props: { genre },
        pageSize: GENRE_PAGE_SIZE,
      }),
    ),
  );
  return pages.flat();
}) satisfies GetStaticPaths;

interface Props {
  genre: Genre;
  page: Page<Game>;
}

const { genre, page } = Astro.props;
const genrePath = `/genre/${genre.slug}`;
const canonical = page.url.current;
// Other pages get their own title and description
const pageSuffix = page.currentPage > 1 ? ` - Page ${page.currentPage}` : ``;
const title = `Durée de vie des jeux ${genre.name}${pageSuffix}`;
const label = genreLabels[genre.slug] ?? genre.name;
const data = await getGenrePageData(genre.slug, await getGenreGames(genre.id));
const median =
  data.reliable && data.stat
    ? ` Durée médiane : ${data.stat.median} h pour ${data.stat.timed} jeux chronométrés.`
    : ``;
const description = `Découvrez le temps nécessaire pour terminer les jeux ${genre.name}.${median}${pageSuffix}`;
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: genre.name, path: genrePath },
  ...(page.currentPage > 1
    ? [{ name: `Page ${page.currentPage}`, path: canonical }]
    : []),
];
const jsonLd = [
  webPageNode({
    type: `CollectionPage`,
    path: canonical,
    name: title,
    description,
    extra: { mainEntity: ref(pageIds(canonical).itemList) },
  }),
  breadcrumbNode(canonical, breadcrumb),
  itemListNode(
    canonical,
    page.data.map((game) => ({ name: game.name, path: `/jeu/${game.slug}` })),
    {
      total: page.total,
      start: page.start,
    },
  ),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  prev={page.url.prev}
  next={page.url.next}
  ogImage={
    data.art
      ? new URL(`/genres/${genre.slug}-1200.webp`, Astro.site).href
      : undefined
  }
  jsonLd={jsonLd}
  preloadFonts={[
    `/fonts/MonumentExtended-Black.woff2`,
    `/fonts/PolySans-Slim.woff2`,
  ]}
>
  <LayoutFront>
    <div class={home.page}>
      <GenreHero
        label={label}
        slug={genre.slug}
        count={page.total}
        page={page.currentPage}
        lastPage={page.lastPage}
        breadcrumb={breadcrumb}
        data={data}
      />
      <GameList games={page.data} start={page.start} label={label} />
      <div class={home.frame}>
        <Pagination
          baseUrl={genrePath}
          currentPage={page.currentPage}
          lastPage={page.lastPage}
        />
      </div>
      {page.currentPage === 1 && data.extremes && (
        <Extremes
          shortest={data.extremes.shortest}
          longest={data.extremes.longest}
          label={label}
        />
      )}
      <SimilarGenres similar={data.similar} reliable={data.reliable} />
    </div>
  </LayoutFront>
</BaseLayout>
