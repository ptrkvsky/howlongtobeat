---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Banner from '@/features/home/components/Banner/Banner.astro';
import { getGames } from '@/features/jeu/api';
import { siteInformations } from '@/config/siteInformations';
import {
  organizationNode,
  ref,
  siteIds,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';

const countGames = (await getGames()).length;
const title = `Découvrez le temps de jeu necessaire pour terminer vous jeux favoris. - ${siteInformations.title}`;
const description = `Game Over repertorie la durée de vie de ${countGames} jeux. Retrouvez toutes les informations sur la duree de vie de l'ensemble de vos jeux preferes.`;
const jsonLd = [
  websiteNode(),
  organizationNode(),
  webPageNode({
    path: `/`,
    name: title,
    description,
    hasBreadcrumb: false,
    extra: { about: ref(siteIds.website) },
  }),
];
---

<BaseLayout absoluteTitle={title} description={description} jsonLd={jsonLd}>
  <LayoutFront cloakFooter={false}>
    <Banner countGames={countGames} />
  </LayoutFront>
</BaseLayout>
