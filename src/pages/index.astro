---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Hero from '@/features/home/components/Hero.astro';
import Milestones from '@/features/home/components/Milestones.astro';
import Finishable from '@/features/home/components/Finishable.astro';
import Ruler from '@/features/home/components/Ruler.astro';
import Questions from '@/features/home/components/Questions.astro';
import TimedNews from '@/features/home/components/TimedNews.astro';
import GenreIndex from '@/features/home/components/GenreIndex.astro';
import home from '@/features/home/components/home.module.css';
import { getHomeData } from '@/features/home/data';
import { siteInformations } from '@/config/siteInformations';
import {
  organizationNode,
  ref,
  siteIds,
  webPageNode,
  websiteNode,
} from '@/utils/structuredData';

const data = await getHomeData();
const title = `Combien de temps pour finir un jeu ? Votre date de fin - ${siteInformations.title}`;
const description = `Durée de vie de ${data.gamesCount.toLocaleString(`fr-FR`)} jeux vidéo, et la date à laquelle vous les finirez à votre rythme. Durées HowLongToBeat, avis Steam, prix et actus.`;
const jsonLd = [
  websiteNode(),
  organizationNode(),
  webPageNode({
    path: `/`,
    name: title,
    description,
    hasBreadcrumb: false,
    extra: { about: ref(siteIds.website) },
  }),
];
---

<BaseLayout
  absoluteTitle={title}
  description={description}
  canonical="/"
  jsonLd={jsonLd}
  preloadFonts={[
    `/fonts/MonumentExtended-Black.woff2`,
    `/fonts/PolySans-Slim.woff2`,
  ]}
>
  <LayoutFront>
    <div class={home.page}>
      <Hero game={data.hero} day={data.day} gamesCount={data.gamesCount} />
      <Milestones game={data.hero} day={data.day} />
      <Finishable
        lists={data.finishable}
        milestone={data.milestone}
        day={data.day}
      />
      <Ruler ruler={data.ruler} />
      {data.example && <Questions example={data.example} day={data.day} />}
      <TimedNews news={data.news} />
      <GenreIndex genres={data.genres} />
    </div>
  </LayoutFront>
</BaseLayout>
