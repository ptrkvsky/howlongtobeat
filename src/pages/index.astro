---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Banner from '@/features/home/components/Banner/Banner.astro';
import { getGames } from '@/features/jeu/api';
import { siteInformations } from '@/config/siteInformations';

const countGames = (await getGames()).length;
---

<BaseLayout
  absoluteTitle={`Découvrez le temps de jeu necessaire pour terminer vous jeux favoris. - ${siteInformations.title}`}
  description={`Game Over repertorie la durée de vie de ${countGames} jeux. Retrouvez toutes les informations sur la duree de vie de l'ensemble de vos jeux preferes.`}
>
  <LayoutFront cloakFooter={false}>
    <Banner countGames={countGames} />
  </LayoutFront>
</BaseLayout>
