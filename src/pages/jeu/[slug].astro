---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import home from '@/features/home/components/home.module.css';
import { today } from '@/features/home/finishDate';
import About from '@/features/jeu/components/About.astro';
import Evidence from '@/features/jeu/components/Evidence.astro';
import GameHero from '@/features/jeu/components/GameHero.astro';
import GameNews from '@/features/jeu/components/GameNews.astro';
import Pace from '@/features/jeu/components/Pace/Pace.astro';
import RelatedGames from '@/features/jeu/components/RelatedGames/RelatedGames.astro';
import { getNewsArticlesByGame } from '@/features/actus/api';
import {
  getGames,
  getRelatedGames,
  getTimeDistribution,
} from '@/features/jeu/api';
import { getAllGenres } from '@/functions/getAllGenres';
import { igdbImage } from '@/utils/igdbImage';
import {
  breadcrumbNode,
  pageIds,
  ref,
  videoGameNode,
  webPageNode,
} from '@/utils/structuredData';

export const getStaticPaths = (async () => {
  const [games, allGenres, distribution] = await Promise.all([
    getGames(),
    getAllGenres(),
    getTimeDistribution(),
  ]);

  return Promise.all(
    games.map(async (game) => ({
      params: { slug: game.slug },
      props: {
        game,
        genres: allGenres.filter((genre) => game.genreIds.includes(genre.id)),
        relatedGames: await getRelatedGames(game),
        news: await getNewsArticlesByGame(game.slug),
        distribution,
      },
    })),
  );
}) satisfies GetStaticPaths;

const { game, genres, relatedGames, news, distribution } = Astro.props;
const canonical = `/jeu/${game.slug}`;
const image = game.cover ? igdbImage(game.cover, `cover_big_2x`) : undefined;
const [mainGenre] = genres;
const title = `Combien de temps faut-il pour terminer ${game.name} ?`;
const description = `Découvrez la durée de vie de ${game.name}. Quel temps vous faudra-t-il pour voir la fin.`;
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  ...(mainGenre
    ? [{ name: mainGenre.name, path: `/genre/${mainGenre.slug}` }]
    : []),
  { name: game.name, path: canonical },
];
const jsonLd = [
  webPageNode({
    path: canonical,
    name: title,
    description,
    extra: {
      mainEntity: ref(pageIds(canonical).game),
      primaryImageOfPage: image,
    },
  }),
  breadcrumbNode(canonical, breadcrumb),
  videoGameNode(game, genres, canonical),
];
// The end dates are written from the build day, then from the visitor's one
const day = today(`Europe/Paris`);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={image}
  jsonLd={jsonLd}
  preloadFonts={[
    `/fonts/MonumentExtended-Black.woff2`,
    `/fonts/PolySans-Slim.woff2`,
  ]}
>
  <LayoutFront>
    <div class={home.page}>
      <GameHero game={game} genres={genres} breadcrumb={breadcrumb} />
      <Pace game={game} day={day} />
      <Evidence game={game} distribution={distribution} />
      <About game={game} genres={genres} />
      <GameNews name={game.name} news={news} />
      <RelatedGames game={game} genre={mainGenre} relatedGames={relatedGames} />
    </div>
  </LayoutFront>
</BaseLayout>
