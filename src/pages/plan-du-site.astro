---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutFront from '@/layouts/LayoutFront.astro';
import Breadcrumb from '@/components/Breadcrumb/Breadcrumb.astro';
import HomeTitle from '@/styles/components/titles/HomeTitle.astro';
import List from '@/styles/components/titles/List.astro';
import { authorPageUrl, authors } from '@/config/authors';
import { getAllGenres } from '@/functions/getAllGenres';
import { breadcrumbNode, webPageNode } from '@/utils/structuredData';
import titles from '@/styles/components/titles/titles.module.css';

const genres = await getAllGenres();
const path = `/plan-du-site`;
const description = `Decouvrez l'ensemble des pages du site internet`;
const breadcrumb = [
  { name: `Accueil`, path: `/` },
  { name: `Plan du site`, path },
];
const jsonLd = [
  webPageNode({ path, name: `Plan du site`, description }),
  breadcrumbNode(path, breadcrumb),
];
---

<BaseLayout title="Plan du site" description={description} jsonLd={jsonLd}>
  <LayoutFront isCentered>
    <Breadcrumb items={breadcrumb} />
    <HomeTitle>Plan du site</HomeTitle>
    <List>
      {genres.map((genre) => (
        <li>
          <a href={`/genre/${genre.slug}`}>{genre.name}</a>
        </li>
      ))}
    </List>
    <h2 class={titles.sectionTitle}>Auteurs</h2>
    <List>
      {Object.values(authors).map((author) => (
        <li>
          <a href={authorPageUrl(author.slug)}>{author.name}</a>
        </li>
      ))}
    </List>
  </LayoutFront>
</BaseLayout>
