{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/actus/article",
      "destination": "/actus",
      "permanent": true
    }
  ]
}
